# Скопируйте этот файл в .env и подставьте свои значения.
# Сам .env в репозиторий не попадает (см. .gitignore).

APP_NAME=Coach App API
DEBUG=true

# Пароль — только латиница и цифры: символы @ : / ломают строку подключения.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/coach
